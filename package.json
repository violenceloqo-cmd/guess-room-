{
  "name": "knock-knock",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "Knock Knock — an interactive Robinhood Chain stream game with a Pons token, neon doorway UI, and auto hot-wallet ETH payouts.",
  "workspaces": [
    "packages/shared",
    "packages/backend",
    "packages/web"
  ],
  "scripts": {
    "build:shared": "npm run build --prefix packages/shared",
    "build:backend": "npm run build --prefix packages/backend",
    "build": "npm run build --workspaces --if-present",
    "start": "node packages/backend/dist/index.js",
    "dev": "npm run dev:shared & npm run dev:backend & npm run dev:web & wait",
    "dev:shared": "npm run dev --workspace @knock-knock/shared",
    "dev:backend": "npm run dev --workspace @knock-knock/backend",
    "dev:web": "npm run dev --workspace @knock-knock/web",
    "test": "npm run test --workspaces --if-present",
    "typecheck": "npm run typecheck --workspaces --if-present"
  },
  "engines": {
    "node": ">=20"
  },
  "devDependencies": {
    "tsx": "^4.19.0",
    "typescript": "^5.6.0",
    "vitest": "^2.1.0"
  }
}
